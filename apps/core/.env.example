# Docker Compose (postgres + redis + adminer)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=cugetreg
POSTGRES_DB=cugetreg

# Prisma / API (local dev — host machine connects to published port 5432)
DATABASE_URL=postgresql://admin:cugetreg@localhost:5432/cugetreg?schema=public

# Auth (replace with real Google OAuth credentials for login flows)
JWT_SECRET=change-me-in-production-min-8-chars
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
APP_MODE=dev
BETTER_AUTH_SECRET=change-me-in-production-min-8-chars
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
