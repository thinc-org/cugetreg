# Reg Chula scrape scope (full scrape: all programs, semesters, no course limit)
SCRAPER_ACADEMIC_YEARS=2568
SCRAPER_STUDY_PROGRAMS=S,T,I
SCRAPER_SEMESTERS=1,2,3

# Rate limiting
SCRAPER_BATCH_SIZE=25
SCRAPER_DELAY_MS=300
SCRAPER_MAX_RETRIES=10

# Empty = discover ALL courses from 28 faculties
SCRAPER_COURSE_NOS=
# 0 = no limit (full scrape). Use e.g. 20 for a quick test.
SCRAPER_MAX_COURSES=0

# Optional: V1 course description CSV
# COURSE_DESC_PATH=../../data/course_chula_full.csv
OVERRIDES_PATH=../../apps/core/bin/overrides.json

# Export targets (comma-separated: json, postgres)
SCRAPER_EXPORTERS=json,postgres

# JSON output for apps/core/bin migrate + backup
SCRAPER_JSON_OUTPUT=../../apps/core/bin/courses.json
SCRAPER_STATUS_OUTPUT=../../apps/reg-scraper-py/data/scraper-status.json

# Same DATABASE_URL as apps/core/.env
DATABASE_URL=postgresql://admin:cugetreg@localhost:5432/cugetreg
