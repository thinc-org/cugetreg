# --- Scrape scope ---
SCRAPER_ACADEMIC_YEARS=2568
SCRAPER_STUDY_PROGRAMS=S
SCRAPER_SEMESTERS=2

# Rate limiting
SCRAPER_BATCH_SIZE=25
SCRAPER_DELAY_MS=300
SCRAPER_MAX_RETRIES=10

# Empty = discover all courses from 28 faculties
SCRAPER_COURSE_NOS=

# PR / local test default: small JSON-only run (no DB writes)
SCRAPER_MAX_COURSES=20
SCRAPER_EXPORTERS=json

# Full scrape + DB (uncomment for integration test)
# SCRAPER_MAX_COURSES=0
# SCRAPER_STUDY_PROGRAMS=S,T,I
# SCRAPER_SEMESTERS=1,2,3
# SCRAPER_EXPORTERS=json,postgres

# Optional course description CSV (not from Reg Chula)
# COURSE_DESC_PATH=../../data/course_chula_full.csv

OVERRIDES_PATH=../../apps/core/bin/overrides.example.json

# Outputs
SCRAPER_JSON_OUTPUT=../../apps/core/bin/courses.json
SCRAPER_STATUS_OUTPUT=../../apps/reg-scraper-py/data/scraper-status.json

# Same as apps/core/.env — only needed when SCRAPER_EXPORTERS includes postgres
DATABASE_URL=postgresql://admin:cugetreg@localhost:5432/cugetreg?schema=public
